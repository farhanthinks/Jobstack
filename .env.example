# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose to the client, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Google OAuth (configured as a provider in Supabase Auth; client ID/secret
# live in the Supabase dashboard, not this app, unless used elsewhere)

# Groq — AI Assistant. Server-only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Resend — reminder emails (tasks, interviews, outreach, deadlines). Server-only.
RESEND_API_KEY=
# Falls back to onboarding@resend.dev (Resend's shared test sender) if unset.
RESEND_FROM_EMAIL=

# Shared secret for the reminder cron route (src/app/api/cron/task-reminders) —
# set the same value here and in whatever scheduler calls that route
# (Authorization: Bearer <value>, or ?secret=<value>).
CRON_SECRET=

# Public base URL of this deployment — used to build links in reminder emails.
# e.g. https://master.xxxxxxxxxxxx.amplifyapp.com, or your custom domain.
NEXT_PUBLIC_SITE_URL=
